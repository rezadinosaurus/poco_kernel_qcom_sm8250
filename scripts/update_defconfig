#!/usr/bin/env bash

# SPDX-License-Identifier: MIT
# Copyright (C) 2022 Utsav Balar

KERNEL_TOP=$(pwd)
KERNEL_CFG=arch/arm64/configs/vendor/xiaomi
OUT_DIR=$KERNEL_TOP/temp
TC_BIN=${TC_BIN:-$KERNEL_TOP/tc/gcc/bin}
export KERNEL_TOP
export KERNEL_CFG
export OUT_DIR

export PATH=$TC_BIN:$PATH
GCC_PREFIX=$(find "$TC_BIN" -name '*-gcc' 2>/dev/null | head -n1 | sed 's/.*\///;s/gcc$//')
if [ -z "$GCC_PREFIX" ]; then
  echo "ERROR: GCC not found in $TC_BIN"
  exit 1
fi
echo "Detected GCC prefix: $GCC_PREFIX"

export ARCH=arm64
export CROSS_COMPILE=$GCC_PREFIX
export CROSS_COMPILE_ARM32=arm-linux-gnueabi-
export CROSS_COMPILE_COMPAT=arm-linux-gnueabi-

BUILD="make O=$OUT_DIR \
ARCH=arm64 \
CROSS_COMPILE=$GCC_PREFIX \
CROSS_COMPILE_ARM32=arm-linux-gnueabi- \
CROSS_COMPILE_COMPAT=arm-linux-gnueabi- \
KCFLAGS=-Wno-error \
-j$(nproc --all)"
export BUILD

cd "$KERNEL_TOP" || exit

KERNEL_DEFCONFIG_URL="https://github.com/rezadinosaurus/android_kernel_qcom_sm8250"
KERNEL_DEFCONFIG_HEAD=$(git -C ${KERNEL_CFG} rev-parse HEAD)

SOC="kona"
ALL_DEVICES="alioth apollo cas cmi dagu elish enuma lmi munch umi thyme psyche"

if [ -n "$1" ] && [ "$1" != "all" ]; then
  case " $ALL_DEVICES " in
    *" $1 "*) ;;
    *) echo "ERROR: unknown device '$1'"; exit 1;;
  esac
  DEVICES=$1
  SUBJECT="ARM64: configs: $1: update auto-generated defconfig for $1"
else
  DEVICES=$ALL_DEVICES
  SUBJECT="ARM64: configs: xiaomi: update auto-generated defconfig for all devices"
fi

KERNEL_COMMIT_MESSAGE=$(cat << EOM
${SUBJECT}

This update is generated automatically by using the update_defconfig script
HEAD of the project used to prepare this commit:
${KERNEL_DEFCONFIG_URL}/tree/${KERNEL_DEFCONFIG_HEAD}
EOM
)

for device in $DEVICES; do
  echo "================================================="
  echo "Your Environment:"
  echo "KERNEL_TOP  : ${KERNEL_TOP}"
  echo "KERNEL_CFG  : ${KERNEL_CFG}"
  echo "OUT_DIR  : ${OUT_DIR}"
  rm -rf "${OUT_DIR}"
  ret=$(mkdir -p "${OUT_DIR}" 2>&1)
  if [ ! -d "${OUT_DIR}" ]; then
    echo "Check your environment"
    echo "ERROR: ${ret}"
    exit 1
  fi

  echo "================================================="
  echo "SOC -> ${SOC} :: Device -> ${device}"
  echo "Running scripts/kconfig/merge_config.sh ..."
  ret=$(scripts/kconfig/merge_config.sh \
    -O "${OUT_DIR}" \
    ${KERNEL_CFG}/../${SOC}-perf_defconfig \
    ${KERNEL_CFG}/sm8250-common.config \
    ${KERNEL_CFG}/"${device}".config 2>&1)

  case "$ret" in
    *"error"*|*"ERROR"*|*"Exit"*) echo "ERROR: $ret"; exit 1;;
  esac

  echo "Building new defconfig ..."
  ret=$(${BUILD} savedefconfig 2>&1)
  case "$ret" in
    *"error"*|*"ERROR"*) echo "ERROR: $ret"; exit 1;;
  esac
  mv "$OUT_DIR"/defconfig ./arch/arm64/configs/"$device"_defconfig
done

echo "================================================="
echo "Done!"
rm -rf "$OUT_DIR"

echo "You can now commit the updated defconfig with the following as the commit message:"
echo "${KERNEL_COMMIT_MESSAGE}"

unset KERNEL_TOP
unset KERNEL_CFG
unset OUT_DIR
unset BUILD
